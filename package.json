{
  "name": "maxklot-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-resume.mjs && npm run build:client && npm run build:ssr && node scripts/prerender.js",
    "build:client": "vite build --outDir dist",
    "build:ssr": "vite build --ssr src/entry-server.jsx --outDir dist-ssr",
    "preview": "vite preview",
    "lint": "oxlint"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.7.0",
    "oxlint": "^1.79.0",
    "vite": "^6.4.3"
  }
}
